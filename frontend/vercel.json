{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites": [
        { "source": "/api/:path*", "destination": "https://REPLACE-WITH-YOUR-RAILWAY-DOMAIN.up.railway.app/api/:path*" },
        { "source": "/uploads/:path*", "destination": "https://REPLACE-WITH-YOUR-RAILWAY-DOMAIN.up.railway.app/uploads/:path*" },
        { "source": "/(.*)", "destination": "/index.html" }
    ]
}

# Dev server port and the backend it proxies /api and /uploads to.
VITE_PORT=3000
VITE_API_PROXY=http://localhost:5000

# API base path. Keep "/api" when the frontend and API share an origin (dev proxy or production build served by the backend).
VITE_API_URL=/api

# Must match the backend's university settings.
VITE_UNIVERSITY_DOMAIN=ddu.ac.in
VITE_UNIVERSITY_TIMEZONE=Asia/Kolkata
VITE_UNIVERSITY_TZ_OFFSET=+05:30

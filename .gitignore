# Repository-wide safety net. backend/.gitignore and frontend/.gitignore hold the app-specific rules.

# Dependencies
node_modules/

# Environment files hold secrets (JWT secrets, SMTP app password, Cloudinary keys).
# Only the committed *.env.example templates are shared.
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output and test coverage
dist/
build/
coverage/
.vite/

# Uploaded files and local database data
uploads/
data/

# Browser-test artifacts
playwright-report/
test-results/

# Temporary files
tmp/
temp/
*.tmp
*.tmp.js

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Local Claude Code settings (per machine)
.claude/settings.local.json

# --- Server ---
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/unisphere
# Frontend origin (CORS + links in emails). Vite dev server runs on 3000.
CLIENT_URL=http://localhost:3000
# Public base URL of this API; only needed when images are stored locally and served from another origin.
PUBLIC_API_URL=

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECURE=false

# --- University ---
UNIVERSITY_DOMAIN=ddu.ac.in
UNIVERSITY_NAME=Dharmsinh Desai University
# Event dates/times are entered in university-local time.
UNIVERSITY_TZ_OFFSET=+05:30

# First admin account, created on startup if no admin exists (must be a faculty-style email).
BOOTSTRAP_ADMIN_EMAIL=admin.ce@ddu.ac.in
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisAdminPassword1
BOOTSTRAP_ADMIN_NAME=University Admin

# --- Email (verification, password reset, notifications) ---
# Leave SMTP_HOST empty in development: emails are captured in the dev inbox at <CLIENT_URL>/dev/inbox instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusConnect <no-reply@campusconnect.local>
# Bulk emails (event launches, results, announcements) are queued and sent at this rate.
# Keep it under your provider limit: a Gmail account allows about 500 emails a day.
EMAIL_RATE_PER_MINUTE=30

# --- Media (club logos, event posters, feed images) ---
# With Cloudinary credentials images go to Cloudinary; otherwise they are saved to UPLOAD_DIR (development).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=campusconnect
UPLOAD_DIR=
MAX_UPLOAD_BYTES=5242880

# --- Club stories (24-hour photos and videos in the campus feed) ---
# Story media is uploaded straight from the browser to Cloudinary (free plan: images and videos, served from its CDN)
# using the CLOUDINARY_* credentials above; nothing but the story's details is stored in MongoDB.
# Without Cloudinary credentials, story files are saved to UPLOAD_DIR (development only).
STORY_LIFETIME_HOURS=24
STORY_MAX_IMAGE_BYTES=10485760
STORY_MAX_VIDEO_BYTES=41943040
STORY_MAX_VIDEO_SECONDS=30
STORY_MAX_ACTIVE_PER_CLUB=30

# --- Rate limits per IP per 15 minutes (campus NAT means many users can share one IP) ---
AUTH_RATE_LIMIT=100
API_RATE_LIMIT=2000
UPLOAD_RATE_LIMIT=60

# --- Tests / demo data ---
# Integration tests use this database and refuse to run unless its name contains "test".
MONGO_TEST_URI=mongodb://127.0.0.1:27017/campusconnect_test
# Password for accounts created by `npm run seed:demo`.
DEMO_PASSWORD=Demo@1234
